# ==============================================================================
# PATCHWORK — DOM Hotfix Governance Platform
# Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` (which is git-ignored) to customize configuration.
# Every setting is optional; the defaults below provide a fully functional local
# demo environment out of the box with zero external API keys required.
# ==============================================================================

# --- API Server (packages/server) ---------------------------------------------
# HTTP Port for the core PATCHWORK API & Verification server
PORT=4000

# JSON database persistence path (defaults to ./data/patchwork-db.json)
DB_PATH=./data/patchwork-db.json

# Baseline URL for the target host website monitored by PATCHWORK
STOREFRONT_URL=http://localhost:3000

# Expose POST /api/admin/reset to restore database to clean demo fixtures
ENABLE_DEMO_RESET=true

# Node runtime environment
NODE_ENV=development

# --- Demo Storefront (packages/storefront) ------------------------------------
# HTTP Port for the target host e-commerce storefront
STOREFRONT_PORT=3000

# --- Operator Dashboard (packages/dashboard) -----------------------------------
# HTTP Port for the PATCHWORK operator control center & visual inspector
DASHBOARD_PORT=5173

# Core API endpoint queried by the browser dashboard runtime
PATCHWORK_API_BASE=http://localhost:4000/api

# --- AI Hotfix Copilot & Failure Diagnostics ---------------------------------
# PATCHWORK includes a deterministic Mock AI Provider enabled by default.
# The Mock AI Provider generates syntactically valid DOM patches, root-cause
# explanations, and drift disambiguations offline with zero external dependencies.
AI_PROVIDER=mock

# Optional external LLM API keys (uncomment to connect live model providers):
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
