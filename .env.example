# PATCHWORK environment variables
# Copy to `.env` (git-ignored) or export in your shell. Every value is optional;
# the defaults below give a working local demo. PATCHWORK has no secrets/API keys.

# --- API server (packages/server) ---------------------------------------------
# Port the API listens on.
PORT=4000
# JSON database file. Defaults to ./data/patchwork-db.json relative to the working directory.
DB_PATH=./data/patchwork-db.json
# Base URL recorded for the seeded demo website (used by verification when none is supplied).
STOREFRONT_URL=http://localhost:3000
# Set to "true" to expose POST /api/admin/reset (wipes data to the demo baseline). Demo only.
ENABLE_DEMO_RESET=false

# --- Demo storefront (packages/storefront) ------------------------------------
STOREFRONT_PORT=3000

# --- Dashboard (packages/dashboard) -------------------------------------------
DASHBOARD_PORT=5173
# URLs the dashboard's browser code talks to (served to the page via /config.js).
PATCHWORK_API_BASE=http://localhost:4000/api
# (STOREFRONT_URL above is also used by the dashboard for previews and inspector.)
