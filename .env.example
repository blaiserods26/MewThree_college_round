# ==============================================================================
# PATCHWORK — DOM Hotfix Governance Platform (Enterprise Edition)
# Environment Configuration Template
# ==============================================================================

# --- API Server (packages/server) ---------------------------------------------
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000/api
CORS_ORIGIN=http://localhost:5173

# --- Demo Storefront (packages/storefront) ------------------------------------
STOREFRONT_PORT=3000
STOREFRONT_URL=http://localhost:3000

# --- Operator Dashboard (packages/dashboard) ----------------------------------
DASHBOARD_PORT=5173
PATCHWORK_API_BASE=http://localhost:4000/api

# --- WebSockets & Real-Time Collaboration -------------------------------------
WS_PORT=4001
WS_PATH=/patchwork-ws
ENABLE_MULTIPLAYER=true
WS_HEARTBEAT_INTERVAL=30000

# --- Database (Supabase) ------------------------------------------------------
# For Enterprise RBAC, Patch Audit Trail, and Real-Time Subscriptions
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Authentication & RBAC (Supabase Auth / JWT) -----------------------------
JWT_SECRET=your-256-bit-jwt-secret
AUTH_ENABLED=true
ADMIN_EMAILS=admin@yourdomain.com

# --- AI Subsystem (Structural DOM Matcher & Hotfix Copilot) ------------------
AI_PROVIDER=mock
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
AI_TEMPERATURE=0.0
AI_MAX_TOKENS=2000

# --- Advanced CI/CD Webhooks (Conflict Pausing) -------------------------------
WEBHOOK_CI_PAUSE_URL=https://gitlab.com/api/v4/projects/.../pause
WEBHOOK_CI_SECRET=your-webhook-secret
SLACK_ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Playwright Verification Gate ---------------------------------------------
VERIFICATION_TIMEOUT_MS=15000
HEADLESS_BROWSER=true
TEST_VIEWPORTS=desktop,mobile

# --- Security & Rate Limiting (DDoS Protection) -------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true

# --- Legacy JSON Fallback (For offline/mock dev) ------------------------------
DB_PATH=./data/patchwork-db.json
ENABLE_DEMO_RESET=true
